# ================================
# CONFIGURATION APPLICATION
# ================================

# Port du serveur
PORT=5000

# Environnement (development, staging, production)
NODE_ENV=development

# ================================
# SÉCURITÉ
# ================================

# Clé secrète JWT (générez une longue chaîne aléatoire en production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-min-32-chars

# Durée d'expiration du token JWT
JWT_EXPIRE=24h

# ================================
# BASE DE DONNÉES
# ================================

# Aucun paramètre SQLite -  utilise database.sqlite local
# Si vous voulez utiliser MySQL/PostgreSQL, modifiez server.js

# ================================
# ORIGINE CORS
# ================================

# Domaines autorisés (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# ================================
# AUTHENTIFICATION PAR DÉFAUT
# ================================
# À utiliser UNIQUEMENT en développement pour initialiser le premier admin
# À /api/auth/init

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@2024

# ================================
# EMAIL (optionnel - pour future fonction reset password)
# ================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ================================
# STOCKAGE (optionnel - pour AWS S3 ou autre)
# ================================

# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
